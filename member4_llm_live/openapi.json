{
  "openapi": "3.1.0",
  "info": {
    "title": "Member 4 ESCO Learner Assessment API",
    "description": "Hackathon MVP: curated/LLM quizzes and experimental BKT estimates. Not a certification.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/skills/coverage": {
      "post": {
        "summary": "Coverage",
        "operationId": "coverage_v1_skills_coverage_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/assessments/start": {
      "post": {
        "summary": "Start Assessment",
        "operationId": "start_assessment_v1_assessments_start_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/assessments/submit": {
      "post": {
        "summary": "Submit Assessment",
        "operationId": "submit_assessment_v1_assessments_submit_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/estimates/from-history": {
      "post": {
        "summary": "Estimate From History",
        "operationId": "estimate_from_history_v1_estimates_from_history_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EstimateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Answer": {
        "properties": {
          "question_id": {
            "type": "string",
            "title": "Question Id"
          },
          "selected_option": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Selected Option"
          }
        },
        "type": "object",
        "required": [
          "question_id",
          "selected_option"
        ],
        "title": "Answer"
      },
      "EstimateRequest": {
        "properties": {
          "learner_id": {
            "type": "string",
            "title": "Learner Id"
          },
          "interaction_history": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Interaction History"
          },
          "method": {
            "type": "string",
            "title": "Method",
            "default": "bkt"
          }
        },
        "type": "object",
        "required": [
          "learner_id",
          "interaction_history"
        ],
        "title": "EstimateRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobSkill": {
        "properties": {
          "esco_id": {
            "type": "string",
            "title": "Esco Id"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "importance": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Importance",
            "default": 1.0
          }
        },
        "type": "object",
        "required": [
          "esco_id"
        ],
        "title": "JobSkill"
      },
      "StartRequest": {
        "properties": {
          "job_skills": {
            "items": {
              "$ref": "#/components/schemas/JobSkill"
            },
            "type": "array",
            "maxItems": 15,
            "minItems": 1,
            "title": "Job Skills"
          },
          "questions_per_skill": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Questions Per Skill",
            "default": 3
          },
          "generate_missing": {
            "type": "boolean",
            "title": "Generate Missing",
            "default": false
          },
          "max_ai_skills": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Max Ai Skills",
            "default": 3
          },
          "include_provisional": {
            "type": "boolean",
            "title": "Include Provisional",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "job_skills"
        ],
        "title": "StartRequest"
      },
      "SubmitRequest": {
        "properties": {
          "assessment_id": {
            "type": "string",
            "title": "Assessment Id"
          },
          "answers": {
            "items": {
              "$ref": "#/components/schemas/Answer"
            },
            "type": "array",
            "title": "Answers"
          },
          "self_ratings": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Self Ratings"
          }
        },
        "type": "object",
        "required": [
          "assessment_id",
          "answers"
        ],
        "title": "SubmitRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}